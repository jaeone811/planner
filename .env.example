# ── 필수 ─────────────────────────────────────────────────────────
# 웹앱 접근 키 (?key=...) 겸 API/크론 인증 키. 충분히 긴 랜덤 문자열 사용
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=change-me-to-a-long-random-string

# 외부에서 접속하는 주소 (Cloud Run 서비스 URL). 카카오 메시지 링크/리다이렉트에 사용
PUBLIC_BASE_URL=http://localhost:8080

# ── 저장소 ───────────────────────────────────────────────────────
# 비워두면 LOCAL_DATA_DIR(기본 ./data) 로컬 파일에 저장
GCS_BUCKET=
# LOCAL_DATA_DIR=./data
# 메모리 캐시 (Cloud Run max-instances=1 전제, GCS 읽기·쓰기 횟수 절약)
# STORAGE_CACHE=true

# ── 카카오 (나에게 보내기) ────────────────────────────────────────
KAKAO_REST_API_KEY=
# 앱 설정에서 클라이언트 시크릿을 '사용함'으로 켠 경우에만 입력
KAKAO_CLIENT_SECRET=
# 기본값: ${PUBLIC_BASE_URL}/kakao/callback  (카카오 콘솔에 동일하게 등록)
# KAKAO_REDIRECT_URI=
# 카톡 메시지 링크에 키 포함 여부 (/k/{key}/{date} 형태 → 브라우저 쿠키에 저장 후 플래너로 이동)
KAKAO_LINK_INCLUDE_KEY=true
# 카톡 피드가 세로로 긴 이미지를 잘라서, 캡처 전체가 보이게 이 비율 캔버스에 맞춰 보냄 (none = 원본 그대로)
# KAKAO_IMAGE_RATIO=3:4

# ── ntfy 푸시 ────────────────────────────────────────────────────
# 토픽 이름이 곧 비밀번호 역할 → 추측 어려운 이름 사용
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# ── 동작 옵션 ────────────────────────────────────────────────────
# APP_TIMEZONE=Asia/Seoul
# NAG_START=08:00
# NAG_END=22:00
# 스케줄러가 늦게 불러도 지정 시각 알림을 놓치지 않도록 허용하는 지연(분)
# NOTIFY_CATCHUP_MINUTES=9
# 플래너 하루 시작 시각 (기본 5 = 새벽 0~4시는 전날 플래너로 취급, 그리드 05~04시와 동일. 0=자정)
# DAY_START_HOUR=5

# ── 캡처 상태바 ─────────────────────────────────────────────────
# random = 캡처할 때마다 시각·배터리 랜덤 (기본) / real = 실제 발송 시각 + 고정 배터리
# STATUS_TIME_MODE=random
# 랜덤 시각 범위 (자정 넘는 범위 가능, 예: 22:00-01:30)
# STATUS_TIME_RANGE=00:00-23:59
# 랜덤 배터리 범위 (%) — 20 이하면 아이폰처럼 빨간색
# STATUS_BATTERY_RANGE=20-100
# real 모드일 때 배터리 값
# STATUS_BATTERY_FIXED=89

# ── 로컬 테스트 전용 ─────────────────────────────────────────────
# Playwright 브라우저를 직접 지정해야 할 때 (Docker 이미지에서는 불필요)
# CHROMIUM_EXECUTABLE=
